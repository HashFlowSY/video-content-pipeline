# Project-local runtime and caches
.venv/
cache/
runtime/python/
tools/uv/

# Model assets stay out of git; only the registry is tracked (Phase 11)
models/*
!models/registry.json

# Project data generated by later phases
tmp/*
!tmp/.gitkeep
input/*
!input/.gitkeep
work/*
!work/.gitkeep
outputs/*
!outputs/.gitkeep

# Generated Phase 3 planning runtime artifacts
plans/reports/
plans/*/run-plan.json
plans/decode-throughput-history.json

# Python tooling
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
coverage.xml
htmlcov/

# OS metadata
.DS_Store
